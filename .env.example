# Environment
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/legal_contracts

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change-this-in-production-to-a-secure-random-key-minimum-32-chars
ENCRYPTION_KEY=change-this-32-byte-key-in-prod!

# LLM API Keys
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# Vector DB
VECTOR_DB_PROVIDER=chromadb
CHROMADB_PERSIST_DIR=./data/chromadb

# Pinecone (optional)
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
